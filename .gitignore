node_modules/

# package.json and its lockfile used to be test-only and were ignored. they are
# now a DEPLOY requirement: vercel installs aws4fetch from them to run
# api/sign.mjs. leaving them untracked means the function fails to build.

# generated by the smoke suite, never committed
tests/fixtures/
tests/vendor/
tests/dl/

# owner-swappable, intentionally absent from the repo
demo.eski

# media stays out of git: host it on R2 and point library/index.json at it
*.eski
!tests/**/*.eski
tests/shots/
