# eski environment variables
# copy the NAMES into the vercel dashboard (project -> settings -> environment
# variables), set them for Production and Preview. never commit real secrets:
# only the "public" values below are safe in git, by design.
#
# "public" MEANS SAFE TO EXPOSE, NOT OPTIONAL. every variable in this file has
# to be set in vercel, including the public ones: api/sign.mjs reads
# SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY to verify the caller's token, and
# R2_BUCKET to build the object path. leaving them out because the browser
# already has them is the obvious mistake, and it fails as
# "server is missing env vars".
#
# vercel does NOT apply env changes to existing deployments. redeploy after
# editing anything here.
#
# PASTE THE VALUE ONLY. vercel's editor has a name box and a value box, so
# copying a whole "NAME=value" line out of this file puts the name inside the
# value. api/sign.mjs strips that back off, along with quotes and stray
# whitespace, but every other consumer will take it literally.

# ---------------------------------------------------------------- supabase
# dashboard -> project settings -> api
SUPABASE_URL=https://zidqagrmxeawpasurpwi.supabase.co          # public
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx   # public, browser-safe
# not used by any code today: the signer verifies a caller by calling
# /auth/v1/user with the publishable key, so nothing needs to bypass RLS.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx             # SERVER ONLY, bypasses row-level security

# ------------------------------------------------------------------- r2
# cloudflare dashboard -> r2 -> overview (account id)
#                     -> r2 -> eski -> settings (custom domain)
#                     -> r2 -> api -> manage api tokens (the key pair)
R2_BUCKET=eski                                                 # public
# public, where readers fetch media. this is the rate-limited r2.dev dev domain;
# swap to https://cdn.eski.lol once the eski.lol zone is on cloudflare. because
# the db stores object KEYS and never full urls, that swap is this one line.
R2_PUBLIC_BASE_URL=https://pub-b9e7c6b680ca415e9ffd5875bad0df03.r2.dev
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx                 # SERVER ONLY
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx              # SERVER ONLY, the "username" half
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx          # SERVER ONLY, the "password" half, shown once

# the s3 endpoint is derived, not stored:
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# that endpoint is for SIGNED api calls only. it is NOT R2_PUBLIC_BASE_URL.

# ------------------------------------------------------------------ mail
# magic-link sender. supabase's built-in mailer is rate limited to a handful of
# emails an hour, so a real sender is required once anyone but the owner signs in.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=                                                     # SERVER ONLY
SMTP_FROM=hello@eski.lol
